# Copy to .env and fill in. Never commit .env.

# Pairing key (required). Every glasses page needs it as ?k=<key>; npm run qr and npm run sim add it.
# The server will not start without it. Create one with: openssl rand -hex 24  (at least 16 characters)
HUD_TOKEN=

# Claude. Leave unset if you are signed in with `ant auth login`.
ANTHROPIC_API_KEY=

# Obsidian: meeting notes go to <vault>/Meetings. Leave unset to save nothing.
OBSIDIAN_VAULT=

# Loops on the Pi, for Around and Sky (SSH key access needed). Leave unset to turn off.
LOOPS_SSH=

# Code app: project folders, comma-separated; each starts as a tab. Leave unset to turn off.
CODE_DIRS=
# CODE_MODEL=   (default: the Agent SDK's model)
# CODE_BUDGET_USD=2   (a number above 0; anything else gives 2)
# CODE_DIRS opens at most 6 tabs.

# HackOS: your own model on an OpenAI-compatible server. Leave unset to turn off.
# The API key is read from the macOS Keychain item "runpod-api-key", or from HACKOS_API_KEY.
HACKOS_URL=
# HACKOS_MODEL=qwen3.8-27b
# HACKOS_REASONING=none
# HACKOS_API_KEY=
# HACKOS_KEYCHAIN_ITEM=runpod-api-key

# Vault recall (Answers). Off unless RECALL_FOLDERS is set. Needs OBSIDIAN_VAULT and HUD_USER_NAME.
# Folders inside the vault that the server may read, comma-separated, "." = whole vault.
# Short extracts of notes named in the conversation go to Anthropic with each request. See Privacy in README.md.
RECALL_FOLDERS=
# RECALL_FOLDERS=People,Projects,Meetings,Daily
# RECALL_EXCLUDE=Private,People/Family
# RECALL_PEOPLE=People
# RECALL_CUE=off

# Optional
# HUD_ORIGIN=http://<your-mac-lan-ip>:5173   (needed only by npm run pack; written into the packed manifests' network whitelist)
# MEETINGS_FOLDER=Meetings
# MEETING_IDLE_MINUTES=10
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
# HUD_USER_NAME=Alex
# CONTEXT_FILE=./context.md
# WHISPER_URL=http://127.0.0.1:8178/inference
# PORT=8787   (moves the server and the Vite /ws proxy)
# LOG_LEVEL=debug
